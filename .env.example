# --- x402 (seller) ---
# testnet = Celo Sepolia USDC (develop here). mainnet = real USA₮/USDC/USD₮ on Celo 42220.
X402_NETWORK=testnet
# From https://x402.celo.org -> Create API key (sign in with GitHub for mainnet free credits).
X402_API_KEY=

# --- the KYA agent wallet: receives payments, owns the ERC-8004 identity, pays for buy services ---
# `npm run wallet` creates one if empty. Keep the same wallet for the whole hackathon.
AGENT_PRIVATE_KEY=
# Optional: receive payments on a different address than the agent wallet.
PAY_TO=
# Filled in after `npm run register`.
KYA_AGENT_ID=

# --- hackathon attribution (ERC-8021). Must be on every tx the agent sends. ---
ATTRIBUTION_CODE=celo_9a5077c029be

# --- buy: pay Chainstack RPC + Cencori inference per call in full reports ---
BUY_ENABLED=0

# Optional: free key from https://dev.blockscout.com raises explorer rate limits.
BLOCKSCOUT_API_KEY=

PORT=8787
PUBLIC_URL=http://localhost:8787
# Prices in 6-decimal units: 10000 = $0.01
PRICE_CHECK=10000
PRICE_REPORT=50000
FREE_PREVIEWS_PER_DAY=20

# --- storage ---
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543, IPv4).
# Leave empty to use an embedded Postgres (PGlite) in data/pglite for local runs.
DATABASE_URL=
